{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(bq *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bq_pre_hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(bq *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bq_post_hook.sh",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
